# Define environment variables for your docker-compose here.
# These will ONLY be used during the compose file interpretation.
# They will NOT be injected into the generated stack environment.
# If you want to add ENVs to the generated stack environment, add them to the stack.env file.
# Example:
# APP_ENV=production
NAS_ADDRESS=172.16.0.154
WOL_LOGIN=
WOL_MACHINE=
WOL_PORT=8009
WOL_MAC_ADDRESS=
